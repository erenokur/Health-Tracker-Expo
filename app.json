{
  "expo": {
    "name": "Health Tracker",
    "slug": "health-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "healthtracker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.yourname.healthtracker",
      "adaptiveIcon": {
        "backgroundColor": "#1E293B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.yourname.healthtracker",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "LatestBp",
              "label": "Son Tansiyon",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "description": "En son tansiyon ölçümünü gösterir",
              "previewImage": "./assets/widget-preview/latest-bp.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
